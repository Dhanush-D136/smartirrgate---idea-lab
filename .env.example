# ==========================================
# SmartIrrigate — vel greenish Configuration
# ==========================================

# Database
# Default: Local SQLite (no Postgres setup needed for instant run)
DATABASE_URL=sqlite:///./smartirrigate.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql://smartirrigate:secret_db_password_2026@localhost:5432/smartirrigate_db

# Security & Session Authentication
SECRET_KEY=smartirrigate-velgreenish-super-secure-key-2026-very-secret-token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# MQTT Broker (Mosquitto on Raspberry Pi or Local)
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=smartirrigate

# Hardware Identifiers
DEFAULT_ESP32_ID=esp32-zone-01
DEFAULT_RPI_ID=rpi4b-edge-01

# Safety Guardrails
STALE_DATA_TIMEOUT_SECONDS=120
COMMAND_ACK_TIMEOUT_SECONDS=10
